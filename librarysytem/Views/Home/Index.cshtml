@{
    ViewData["Title"] = "Forma | Learn with intention";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-shade"></div>
    <div class="hero-content">
        <p class="eyebrow"><span></span> A better way to grow</p>
        <h1 id="hero-title">Make room<br />for what’s next.</h1>
        <p class="hero-copy">Curious minds make remarkable things. Find a course that meets you where you are, and takes you somewhere new.</p>
        <a class="button button-light" href="#courses">Find your next course <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-caption"><span>Learn at your own pace</span><span>01 / 03</span></div>
</section>

<section class="courses-section" id="courses" aria-labelledby="courses-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow eyebrow-dark">A place to begin</p>
            <h2 id="courses-title">Ideas worth your time.</h2>
        </div>
        <p class="section-intro">Small, considered courses to help you build skills that stay with you.</p>
    </div>
    <div class="course-grid">
        <article class="course-card">
            <div class="course-image image-design">
                <img src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=900&q=85" alt="" loading="lazy" />
                <span class="image-label">01 — Creative practice</span>
            </div>
            <div class="course-meta"><span>Design</span><span>4 weeks</span></div>
            <h3>Design fundamentals</h3>
            <p>See the everyday world with a designer’s eye, and turn good ideas into clear visuals.</p>
        </article>
        <article class="course-card">
            <div class="course-image image-data">
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=900&q=85" alt="" loading="lazy" />
                <span class="image-label">02 — Everyday analytics</span>
            </div>
            <div class="course-meta"><span>Data</span><span>3 weeks</span></div>
            <h3>Data, made clear</h3>
            <p>Get comfortable asking better questions and finding the story inside the numbers.</p>
        </article>
        <article class="course-card">
            <div class="course-image image-writing">
                <img src="https://images.unsplash.com/photo-1455390582262-044c?auto=format&fit=crop&w=900&q=85" alt="" loading="lazy" />
                <span class="image-label">03 — Words &amp; ideas</span>
            </div>
            <div class="course-meta"><span>Writing</span><span>2 weeks</span></div>
            <h3>The art of storytelling</h3>
            <p>Shape a message people remember, whether you’re writing a page or telling a story.</p>
        </article>
    </div>
</section>

<section class="closing-note">
    <p>Good things start with a little curiosity.</p>
    <a href="#courses" aria-label="Explore courses">Explore the courses <span aria-hidden="true">↗</span></a>
</section>
