<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav-shell" aria-label="Main navigation">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Forma home">
                <span class="brand-mark" aria-hidden="true">f</span>
                <span>forma</span>
            </a>
            <div class="nav-links">
                <a href="#courses">Courses</a>
            </div>
            <a class="nav-cta" href="#courses">Explore courses <span aria-hidden="true">↗</span></a>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <a class="brand brand-footer" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true">f</span>
            <span>forma</span>
        </a>
        <p>Thoughtful learning for wherever you’re headed.</p>
        <span class="footer-note">© 2026 Forma Learning</span>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
